@model Ban_Do_An_Vat.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<div class="max-w-2xl mx-auto my-16 px-6">
    <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-brand-forest/5">
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-brand-forest">Thông Tin Tài Khoản</h1>
            <p class="text-sm text-gray-500 mt-2">Xem và cập nhật thông tin cá nhân của bạn.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-6 p-4 rounded-2xl bg-green-50 border border-green-200 text-green-800 text-sm font-semibold flex items-center gap-2">
                <i class="ph ph-check-circle-bold text-lg"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        <form asp-action="Profile" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-semibold mb-4"></div>

            <div>
                <label asp-for="FullName" class="block text-sm font-semibold text-brand-forest mb-2">Họ và tên</label>
                <input asp-for="FullName" class="w-full bg-brand-bone border border-brand-forest/10 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-brand-matcha" />
                <span asp-validation-for="FullName" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-semibold text-brand-forest mb-2">Email</label>
                <input asp-for="Email" class="w-full bg-brand-bone border border-brand-forest/10 rounded-2xl px-4 py-3 text-sm focus:outline-none opacity-60" readonly />
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-semibold text-brand-forest mb-2">Số điện thoại</label>
                <input asp-for="PhoneNumber" class="w-full bg-brand-bone border border-brand-forest/10 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-brand-matcha" />
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Address" class="block text-sm font-semibold text-brand-forest mb-2">Địa chỉ giao hàng mặc định</label>
                <textarea asp-for="Address" rows="3" class="w-full bg-brand-bone border border-brand-forest/10 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-brand-matcha" placeholder="Địa chỉ nhận đồ ăn vặt của bạn"></textarea>
                <span asp-validation-for="Address" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="w-full bg-brand-coral text-white font-bold py-3.5 rounded-full hover:bg-brand-coral/90 transition-all shadow-md shadow-brand-coral/20">
                Lưu Thay Đổi
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
