@model Ban_Do_An_Vat.Models.Order
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isPaid = Model.PaymentMethod == "COD" || Model.PaymentStatus == "Paid";
    ViewData["Title"] = isPaid ? "Đặt Hàng Thành Công" : "Thanh Toán Đơn Hàng";
    var bankId = Configuration["VietQR:BankId"] ?? "MB";
    var accountNo = Configuration["VietQR:AccountNo"] ?? "123456789";
    var accountName = Configuration["VietQR:AccountName"] ?? "TIEM AN VAT MUNCHIES";
    var template = Configuration["VietQR:Template"] ?? "qr_only";
    var description = $"MUNCH{Model.Id}";
    var vietQrUrl = $"https://img.vietqr.io/image/{bankId}-{accountNo}-{template}.jpg?amount={(long)Model.TotalAmount}&addInfo={description}&accountName={Uri.EscapeDataString(accountName)}";
}

<section class="max-w-3xl mx-auto px-6 py-16 md:py-24 text-center animate-fade-up space-y-8">
    
    @if (!isPaid)
    {
        <!-- ==================== PAYMENT PENDING STATE ==================== -->
        <div class="space-y-4 flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-amber-50 text-amber-500 border border-amber-100 flex items-center justify-center text-4xl shadow-sm">
                <i class="ph-bold ph-qr-code animate-pulse"></i>
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-brand-forest">Thanh Toán Đơn Hàng</h1>
            <p class="text-gray-500 max-w-md mx-auto text-sm">
                Vui lòng hoàn tất thanh toán để hoàn tất quá trình đặt hàng đơn #MUNCH-@Model.Id.ToString("D5").
            </p>

            @if (TempData["PaymentError"] != null)
            {
                <div class="mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold max-w-md mx-auto flex items-center gap-2 justify-center">
                    <i class="ph ph-warning text-lg"></i>
                    <span>@TempData["PaymentError"]</span>
                </div>
            }
        </div>

        @if (Model.PaymentMethod == "VietQR")
        {
            <!-- VietQR Payment Info Block -->
            <div class="max-w-xl mx-auto p-6 rounded-[2rem] bg-white border border-brand-forest/10 shadow-sm space-y-6 text-left animate-fade-up">
                <div class="text-center space-y-2">
                    <h3 class="text-lg font-bold text-brand-forest flex items-center justify-center gap-2">
                        <i class="ph ph-qr-code text-brand-coral text-xl"></i>
                        Quét Mã VietQR Thanh Toán
                    </h3>
                    <p class="text-xs text-gray-500">Mở ứng dụng ngân hàng di động bất kỳ của bạn để quét mã chuyển tiền nhanh 24/7.</p>
                </div>

                <div class="flex flex-col md:flex-row items-center justify-center gap-6">
                    <!-- QR Code Image -->
                    <div class="p-3 bg-white border border-brand-forest/5 rounded-2xl shadow-sm">
                        <img src="@vietQrUrl" alt="Mã VietQR Chuyển Khoản" class="w-48 h-48 md:w-52 md:h-52 object-contain" />
                    </div>

                    <!-- Banking details for manual transfer fallback -->
                    <div class="text-left space-y-3 text-xs w-full max-w-[280px]">
                        <div class="border-b border-brand-forest/5 pb-2">
                            <span class="text-gray-400 block font-semibold uppercase text-[10px] tracking-wider">Ngân hàng nhận</span>
                            <span class="font-bold text-brand-forest text-sm">@bankId</span>
                        </div>
                        <div class="border-b border-brand-forest/5 pb-2">
                            <span class="text-gray-400 block font-semibold uppercase text-[10px] tracking-wider">Số tài khoản</span>
                            <span class="font-mono font-bold text-brand-forest text-sm flex items-center justify-between">
                                <span>@accountNo</span>
                                <button onclick="navigator.clipboard.writeText('@accountNo'); showToast('Đã sao chép số tài khoản!');" class="text-brand-coral hover:text-brand-coral/80">
                                    <i class="ph ph-copy"></i>
                                </button>
                            </span>
                        </div>
                        <div class="border-b border-brand-forest/5 pb-2">
                            <span class="text-gray-400 block font-semibold uppercase text-[10px] tracking-wider">Chủ tài khoản</span>
                            <span class="font-bold text-brand-forest">@accountName</span>
                        </div>
                        <div class="border-b border-brand-forest/5 pb-2">
                            <span class="text-gray-400 block font-semibold uppercase text-[10px] tracking-wider">Số tiền chuyển</span>
                            <span class="font-mono font-bold text-brand-coral text-sm">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="pb-1">
                            <span class="text-gray-400 block font-semibold uppercase text-[10px] tracking-wider">Nội dung chuyển khoản</span>
                            <span class="font-mono font-bold text-brand-forest text-sm flex items-center justify-between">
                                <span>@description</span>
                                <button onclick="navigator.clipboard.writeText('@description'); showToast('Đã sao chép nội dung chuyển khoản!');" class="text-brand-coral hover:text-brand-coral/80">
                                    <i class="ph ph-copy"></i>
                                </button>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-amber-50 rounded-xl border border-amber-100 text-[10px] text-amber-800 leading-relaxed flex items-start gap-2">
                    <i class="ph ph-info text-sm flex-shrink-0 mt-0.5"></i>
                    <span><strong>Lưu ý quan trọng:</strong> Vui lòng giữ nguyên <strong>nội dung chuyển khoản</strong> mặc định ở trên để cửa hàng dễ dàng đối soát đơn hàng của bạn. Đơn hàng sẽ được cập nhật xử lý sớm nhất có thể sau khi chúng tôi nhận được chuyển khoản.</span>
                </div>
            </div>

            <div class="flex flex-col items-center gap-3 pt-4">
                <a asp-action="ConfirmVietQRPayment" asp-route-id="@Model.Id" class="btn-premium btn-premium-primary shadow-md px-10 py-3.5 font-bold text-sm">
                    <span>Tôi Đã Chuyển Khoản Thành Công</span>
                    <span class="btn-icon-wrapper">
                        <i class="ph-bold ph-check-square"></i>
                    </span>
                </a>
                <p class="text-xs text-gray-500">Vui lòng bấm nút này sau khi đã thực hiện chuyển tiền thành công để hoàn tất đơn.</p>
            </div>
        }
        else if (Model.PaymentMethod == "Momo")
        {
            <!-- Momo Pending Block -->
            <div class="max-w-xl mx-auto p-8 rounded-[2rem] bg-white border border-brand-forest/10 shadow-sm space-y-6 text-center animate-fade-up">
                <div class="w-16 h-16 mx-auto rounded-2xl bg-[#a50064] text-white flex items-center justify-center text-4xl font-extrabold">
                    M
                </div>
                <div class="space-y-2">
                    <h3 class="text-lg font-bold text-brand-forest">Thanh toán Ví điện tử MoMo</h3>
                    <p class="text-sm text-gray-500 max-w-sm mx-auto">Vui lòng hoàn tất thanh toán MoMo bằng cách click vào nút bên dưới để chuyển tới cổng MoMo.</p>
                </div>
                
                <div class="border-t border-b border-brand-forest/5 py-4 my-2 text-left max-w-xs mx-auto text-xs space-y-2">
                    <div class="flex justify-between">
                        <span class="text-gray-400">Số tiền thanh toán:</span>
                        <span class="font-mono font-bold text-brand-forest text-sm">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-400">Mã đơn hàng:</span>
                        <span class="font-mono font-bold text-brand-forest">#MUNCH-@Model.Id.ToString("D5")</span>
                    </div>
                </div>

                <div class="flex flex-col items-center gap-3 pt-2">
                    <a asp-action="ReinitMomoPayment" asp-route-id="@Model.Id" class="btn-premium btn-premium-primary bg-[#a50064] hover:bg-[#8e0055] text-white shadow-md px-10 py-3.5 font-bold text-sm flex items-center justify-center gap-2">
                        <span>Tiến Hành Thanh Toán</span>
                        <span class="btn-icon-wrapper">
                            <i class="ph-bold ph-wallet"></i>
                        </span>
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <!-- ==================== ORDER COMPLETED / SUCCESS STATE ==================== -->
        <!-- Success Badge -->
        <div class="space-y-4 flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-green-50 text-green-500 border border-green-100 flex items-center justify-center text-4xl shadow-sm">
                <i class="ph-bold ph-check-circle animate-pulse"></i>
            </div>
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-brand-forest">Đặt Hàng Thành Công!</h1>
            <p class="text-gray-500 max-w-md mx-auto">
                Cảm ơn bạn đã lựa chọn tiệm ăn vặt Munchies. Đơn hàng của bạn đã được tiếp nhận và đang được xử lý.
            </p>

            @if (TempData["PaymentSuccessMsg"] != null)
            {
                <div class="mt-4 p-4 rounded-xl bg-green-50 border border-green-200 text-green-700 text-sm font-semibold max-w-md mx-auto flex items-center gap-2 justify-center">
                    <i class="ph ph-shield-check-bold text-lg"></i>
                    <span>@TempData["PaymentSuccessMsg"]</span>
                </div>
            }
        </div>

        <!-- Order Summary Cards (Double Bezel style) -->
        <div class="outer-shell text-left max-w-xl mx-auto">
            <div class="inner-core space-y-6">
                <div class="flex items-center justify-between border-b border-brand-forest/5 pb-4">
                    <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Mã đơn hàng</span>
                    <span class="font-mono font-bold text-brand-forest">#MUNCH-@Model.Id.ToString("D5")</span>
                </div>

                <!-- Payment Method and Status -->
                <div class="grid grid-cols-2 gap-4 border-b border-brand-forest/5 pb-4">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400">Phương thức thanh toán</span>
                        <span class="font-bold text-sm text-brand-forest mt-1">
                            @if (Model.PaymentMethod == "Momo")
                            {
                                <span class="text-[#a50064] flex items-center gap-1.5">
                                    <svg viewBox="0 0 100 100" class="w-4 h-4 inline-block">
                                        <rect width="100" height="100" rx="20" fill="#a50064"/>
                                        <circle cx="50" cy="50" r="22" fill="#fff"/>
                                        <circle cx="50" cy="50" r="16" fill="#a50064"/>
                                        <circle cx="50" cy="50" r="10" fill="#fff"/>
                                    </svg>
                                    Ví MoMo (Đã thanh toán)
                                </span>
                            }
                            else if (Model.PaymentMethod == "VietQR")
                            {
                                <span class="text-brand-matcha flex items-center gap-1"><i class="ph ph-qr-code text-sm"></i> VietQR (Đã chuyển khoản)</span>
                            }
                            else
                            {
                                <span class="text-gray-600 flex items-center gap-1"><i class="ph ph-hand-coins text-sm"></i> COD (Nhận hàng trả tiền)</span>
                            }
                        </span>
                    </div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-gray-400 mb-1">Trạng thái thanh toán</span>
                        <span>
                            @if (Model.PaymentStatus == "Paid")
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-green-50 text-green-700 border border-green-200">Đã thanh toán</span>
                            }
                            else if (Model.PaymentStatus == "Failed")
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-red-50 text-red-700 border border-red-200">Thanh toán thất bại</span>
                            }
                            else
                            {
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-50 text-amber-700 border border-amber-200">Chờ thanh toán</span>
                            }
                        </span>
                    </div>
                </div>
                
                <!-- Delivery Details -->
                <div class="space-y-3">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-brand-matcha">Thông tin nhận hàng</h4>
                    <div class="text-sm space-y-1.5 text-gray-600">
                        <p class="font-bold text-brand-forest">@Model.CustomerName</p>
                        <p><i class="ph ph-phone text-xs mr-1"></i> @Model.CustomerPhone</p>
                        <p><i class="ph ph-envelope text-xs mr-1"></i> @Model.CustomerEmail</p>
                        <p><i class="ph ph-map-pin text-xs mr-1"></i> @Model.DeliveryAddress</p>
                    </div>
                </div>

                <!-- Items -->
                <div class="space-y-3 border-t border-brand-forest/5 pt-4">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-brand-matcha">Sản phẩm đã mua</h4>
                    <div class="divide-y divide-brand-forest/5">
                        @foreach (var item in Model.OrderItems)
                        {
                            <div class="py-2.5 flex justify-between text-sm">
                                <span class="text-brand-forest">
                                    @if (item.ComboId > 0)
                                    {
                                        <span class="inline-block bg-brand-coral text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded mr-1">COMBO</span>
                                        @item.Combo?.Name
                                    }
                                    else
                                    {
                                        @item.Snack?.Name
                                    }
                                    <span class="text-xs text-gray-400">x @item.Quantity</span>
                                </span>
                                <span class="font-mono text-gray-600">@((item.Price * item.Quantity).ToString("N0")) đ</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Total Payment -->
                <div class="border-t border-brand-forest/5 pt-4 space-y-2 text-xs">
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="flex justify-between text-gray-500 font-semibold">
                            <span>Giảm giá (@Model.CouponCode):</span>
                            <span class="font-mono">-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                    }
                    <div class="flex items-baseline justify-between border-t border-brand-forest/5 pt-2 text-sm font-bold">
                        <span class="text-brand-forest">Tổng thanh toán:</span>
                        <span class="text-xl font-mono font-extrabold text-brand-coral">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex justify-center gap-4 pt-4">
            <a asp-controller="Snacks" asp-action="Index" class="btn-premium btn-premium-primary group">
                <span>Tiếp Tục Mua Sắm</span>
                <span class="btn-icon-wrapper">
                    <i class="ph-bold ph-arrow-right"></i>
                </span>
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn-premium btn-premium-secondary">
                <span>Về Trang Chủ</span>
            </a>
        </div>
    }

</section>
