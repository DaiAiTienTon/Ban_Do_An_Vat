@model ErrorViewModel
@{
    ViewData["Title"] = Model.StatusCode switch
    {
        404 => "Không tìm thấy trang",
        403 => "Không có quyền truy cập",
        _ => "Lỗi hệ thống"
    };

    var heading = Model.StatusCode switch
    {
        404 => "404 — Không tìm thấy trang",
        403 => "403 — Không có quyền truy cập",
        _ => "Đã xảy ra lỗi"
    };

    var message = Model.StatusCode switch
    {
        404 => "Trang hoặc sản phẩm bạn tìm kiếm không tồn tại, đã bị xóa, hoặc địa chỉ không chính xác.",
        403 => "Bạn không có quyền thực hiện thao tác này. Vui lòng đăng nhập bằng tài khoản phù hợp.",
        _ => "Đã xảy ra lỗi khi xử lý yêu cầu của bạn. Vui lòng thử lại sau."
    };
}

<div class="container py-5 text-center" style="max-width: 640px;">
    <h1 class="display-1 fw-bold text-danger">@(Model.StatusCode ?? 500)</h1>
    <h2 class="mb-3">@heading</h2>
    <p class="text-muted mb-4">@message</p>
    <a class="btn btn-primary px-4" href="/">Về trang chủ</a>
    <a class="btn btn-outline-secondary px-4 ms-2" href="/Snacks">Xem sản phẩm</a>

    @if (!Model.StatusCode.HasValue && Model.ShowRequestId)
    {
        <p class="mt-4 text-muted small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
