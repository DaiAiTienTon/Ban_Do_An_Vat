@model Ban_Do_An_Vat.Models.Combo
@{
    ViewData["Title"] = Model.Name + " - Combo Munchies";
}

<!-- Hero -->
<section class="max-w-7xl mx-auto px-6 pt-10 pb-6">
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a asp-controller="Home" asp-action="Index" class="hover:text-brand-coral transition-colors">Trang chủ</a>
        <i class="ph ph-caret-right text-xs"></i>
        <a asp-controller="Combos" asp-action="Index" class="hover:text-brand-coral transition-colors">Combo ưu đãi</a>
        <i class="ph ph-caret-right text-xs"></i>
        <span class="text-brand-forest font-semibold">@Model.Name</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Left: Image -->
        <div class="relative">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name"
                     class="w-full rounded-3xl object-cover shadow-xl border border-brand-forest/10 aspect-square" />
            }
            else
            {
                <div class="w-full aspect-square rounded-3xl bg-gradient-to-br from-brand-amber/20 to-brand-coral/10 flex flex-col items-center justify-center">
                    <i class="ph ph-package text-8xl text-brand-amber/40"></i>
                    <p class="text-brand-amber/60 font-semibold mt-4">COMBO</p>
                </div>
            }
            <!-- Discount ribbon -->
            <div class="absolute top-5 left-5 bg-brand-coral text-white font-extrabold text-lg px-4 py-2 rounded-2xl shadow-lg flex items-center gap-2">
                <i class="ph-bold ph-lightning"></i>
                TIẾT KIỆM @Model.DiscountPercent%
            </div>
        </div>

        <!-- Right: Info -->
        <div class="space-y-6 lg:pt-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-brand-forest leading-tight">@Model.Name</h1>
                <p class="text-gray-500 mt-3 leading-relaxed text-base">@Model.Description</p>
            </div>

            <!-- Price Block -->
            <div class="bg-gradient-to-br from-brand-forest/5 to-brand-amber/5 rounded-2xl p-6 border border-brand-forest/10 space-y-3">
                <div class="flex items-center gap-4">
                    <div>
                        <p class="text-xs text-gray-400 uppercase tracking-wider font-semibold mb-1">Giá gốc (mua lẻ)</p>
                        <p class="text-xl text-gray-400 line-through font-semibold">@Model.OriginalPrice.ToString("N0")đ</p>
                    </div>
                    <div class="w-px h-12 bg-brand-forest/10"></div>
                    <div>
                        <p class="text-xs text-brand-coral uppercase tracking-wider font-bold mb-1">Giá COMBO</p>
                        <p class="text-4xl font-extrabold text-brand-coral">@Model.SalePrice.ToString("N0")đ</p>
                    </div>
                </div>
                <div class="bg-green-50 rounded-xl px-4 py-3 flex items-center gap-3 border border-green-100">
                    <i class="ph ph-piggy-bank text-green-500 text-xl"></i>
                    <div>
                        <p class="text-sm font-bold text-green-700">Tiết kiệm <span class="text-base">@((Model.OriginalPrice - Model.SalePrice).ToString("N0"))đ</span></p>
                        <p class="text-xs text-green-600 mt-0.5">So với mua từng sản phẩm riêng lẻ</p>
                    </div>
                </div>
            </div>

            <!-- Products in combo -->
            <div class="bg-white rounded-2xl border border-brand-forest/10 overflow-hidden shadow-sm">
                <div class="px-5 py-4 border-b border-brand-forest/5 bg-brand-forest/3">
                    <h3 class="font-extrabold text-brand-forest flex items-center gap-2">
                        <i class="ph ph-cookie text-brand-coral"></i>
                        Sản phẩm trong combo (@Model.ComboItems.Count món)
                    </h3>
                </div>
                <div class="divide-y divide-brand-forest/5">
                    @foreach (var item in Model.ComboItems)
                    {
                        <div class="flex items-center gap-4 px-5 py-4">
                            @if (!string.IsNullOrEmpty(item.Snack?.ImageUrl))
                            {
                                <img src="@item.Snack.ImageUrl" alt="@item.Snack.Name"
                                     class="w-14 h-14 rounded-xl object-cover border border-brand-forest/10 shadow-sm" />
                            }
                            else
                            {
                                <div class="w-14 h-14 rounded-xl bg-brand-amber/15 flex items-center justify-center">
                                    <i class="ph ph-cookie text-brand-amber text-2xl"></i>
                                </div>
                            }
                            <div class="flex-1">
                                <p class="font-bold text-brand-forest text-sm">@item.Snack?.Name</p>
                                <p class="text-xs text-gray-400 mt-0.5">@item.Snack?.Category?.Name</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-gray-400">Số lượng</p>
                                <p class="font-extrabold text-brand-coral text-lg">×@item.Quantity</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quantity and Add to Cart CTA -->
            <div class="bg-brand-forest/5 rounded-2xl p-5 border border-brand-forest/5 space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-bold text-brand-forest">Chọn số lượng:</span>
                    <div class="flex items-center gap-1.5 bg-white border border-brand-forest/10 rounded-xl p-1">
                        <button type="button" onclick="changeQty(-1)" class="w-8 h-8 rounded-lg flex items-center justify-center bg-brand-forest/5 hover:bg-brand-forest/10 text-brand-forest font-bold text-base transition-colors">-</button>
                        <input id="combo-quantity" type="number" value="1" min="1" max="99" readonly class="w-10 text-center font-mono font-bold text-brand-forest bg-transparent focus:outline-none" />
                        <button type="button" onclick="changeQty(1)" class="w-8 h-8 rounded-lg flex items-center justify-center bg-brand-forest/5 hover:bg-brand-forest/10 text-brand-forest font-bold text-base transition-colors">+</button>
                    </div>
                </div>

                <div class="flex gap-3">
                    <button onclick="addComboToCart(@Model.Id, '@Html.Raw(Model.Name.Replace("'", "\\'"))')"
                            class="flex-1 bg-brand-coral hover:bg-brand-coral/90 text-white font-extrabold py-4 rounded-xl flex items-center justify-center gap-2 transition-all hover:shadow-lg text-sm">
                        <i class="ph ph-shopping-cart-simple text-lg"></i>
                        THÊM VÀO GIỎ HÀNG
                    </button>
                </div>
            </div>

            <!-- Back links -->
            <div class="flex gap-3">
                <a asp-controller="Snacks" asp-action="Index"
                   class="flex-1 bg-brand-forest/5 hover:bg-brand-forest/10 text-brand-forest font-semibold py-3 rounded-xl flex items-center justify-center gap-1.5 transition-all text-xs border border-brand-forest/5">
                    <i class="ph ph-storefront"></i>
                    Mua sản phẩm lẻ
                </a>
                <a asp-controller="Combos" asp-action="Index"
                   class="flex-1 bg-brand-forest/5 hover:bg-brand-forest/10 text-brand-forest font-semibold py-3 rounded-xl flex items-center justify-center gap-1.5 transition-all text-xs border border-brand-forest/5">
                    <i class="ph ph-arrow-left"></i>
                    Xem thêm combo
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Toast notification -->
<div id="combo-toast"
     class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[9995] hidden bg-brand-forest text-white text-sm font-semibold px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-2 transition-all">
    <i class="ph ph-check-circle text-green-400 text-lg"></i>
    <span id="combo-toast-msg">Combo đã thêm vào giỏ hàng!</span>
</div>

<script>
    function changeQty(amount) {
        var input = document.getElementById('combo-quantity');
        var val = parseInt(input.value) || 1;
        val += amount;
        if (val < 1) val = 1;
        if (val > 99) val = 99;
        input.value = val;
    }

    function addComboToCart(comboId, comboName) {
        var qty = parseInt(document.getElementById('combo-quantity').value) || 1;
        $.ajax({
            url: '/Cart/AddCombo',
            method: 'POST',
            data: { comboId: comboId, quantity: qty },
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(res) {
                if (res.success) {
                    showComboToast('✅ «' + comboName + '» đã thêm vào giỏ!');
                    // Cập nhật badge giỏ hàng
                    if (res.cartCount !== undefined) {
                        var badge = document.getElementById('cart-count-badge') || document.getElementById('cart-badge-count');
                        if (badge) { badge.textContent = res.cartCount; badge.classList.remove('hidden'); }
                    }
                } else {
                    showComboToast('❌ ' + (res.message || 'Không thể thêm combo!'), true);
                }
            },
            error: function() { showComboToast('❌ Lỗi kết nối!', true); }
        });
    }

    function showComboToast(msg, isError) {
        var toast = document.getElementById('combo-toast');
        document.getElementById('combo-toast-msg').textContent = msg;
        toast.classList.remove('hidden');
        toast.style.opacity = '1';
        if (isError) toast.classList.add('bg-red-600');
        else toast.classList.remove('bg-red-600');
        setTimeout(function() { toast.style.opacity = '0'; setTimeout(function() { toast.classList.add('hidden'); }, 300); }, 3000);
    }

    // Anti-forgery token injection if missing
    document.addEventListener('DOMContentLoaded', function() {
        if (!document.querySelector('input[name="__RequestVerificationToken"]')) {
            var token = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] || '';
            if (token) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = '__RequestVerificationToken';
                input.value = token;
                document.body.appendChild(input);
            }
        }
    });
</script>
