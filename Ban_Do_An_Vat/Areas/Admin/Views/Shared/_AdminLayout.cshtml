<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Munchies Admin</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            forest: '#0F2C1F',
                            matcha: '#2D6A4F',
                            coral: '#EA580C',
                            amber: '#F7A072',
                            bone: '#FAF9F6',
                            dark: '#0F172A',
                            light: '#F8FAFC'
                        }
                    },
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        display: ['Bricolage Grotesque', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    
    <!-- Phosphor Icons (Local Offline-First) -->
    <link rel="stylesheet" href="~/lib/phosphor-icons/src/style.css" asp-append-version="true" />
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-brand-light text-brand-dark min-h-screen flex flex-col md:flex-row">
    
    <!-- Grain Noise Overlay -->
    <div class="grain-noise"></div>

    <!-- Admin Sidebar Navigation -->
    <aside class="w-full md:w-64 bg-brand-forest text-brand-bone flex-shrink-0 flex flex-col justify-between p-6">
        <div class="space-y-8">
            <!-- Brand Logo -->
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group border-b border-brand-bone/10 pb-6">
                <img src="/images/logo.png" alt="MUNCHIES Logo" class="h-8 w-auto object-contain bg-white rounded-lg p-0.5" />
                <span class="font-extrabold text-lg tracking-tight text-white uppercase">Munchies Admin</span>
            </a>

            <!-- Menu List -->
            <nav class="space-y-1">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-squares-four text-lg"></i>
                    <span>Bảng điều khiển</span>
                </a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Categories" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-list-dashes text-lg"></i>
                    <span>Quản lý danh mục</span>
                </a>
                <a asp-area="Admin" asp-controller="Snacks" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Snacks" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-cookie text-lg"></i>
                    <span>Quản lý món ăn</span>
                </a>
                <a asp-area="Admin" asp-controller="Combos" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Combos" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-package text-lg"></i>
                    <span>Quản lý Combo</span>
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Orders" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-receipt text-lg"></i>
                    <span>Quản lý đơn hàng</span>
                </a>
                <a asp-area="Admin" asp-controller="Customers" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Customers" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-users text-lg"></i>
                    <span>Quản lý khách hàng</span>
                </a>
                <a asp-area="Admin" asp-controller="Coupons" asp-action="Index" 
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all @(ViewData["ActivePage"]?.ToString() == "Coupons" ? "bg-brand-coral text-white shadow-md" : "text-brand-bone/70 hover:bg-white/5 hover:text-white")">
                    <i class="ph ph-ticket text-lg"></i>
                    <span>Mã giảm giá (Coupons)</span>
                </a>
            </nav>
        </div>

        <!-- Footer / Back to Main Web -->
        <div class="pt-6 border-t border-brand-bone/10 mt-8 space-y-4">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-2 rounded-xl text-xs font-semibold text-brand-bone/60 hover:text-white hover:bg-white/5 transition-colors">
                <i class="ph ph-arrow-left"></i>
                <span>Xem Website</span>
            </a>
            
            <!-- User Status Info -->
            <div class="flex items-center gap-3 px-4 py-2">
                <div class="w-8 h-8 rounded-full bg-brand-coral/20 text-brand-coral flex items-center justify-center font-bold text-xs">
                    AD
                </div>
                <div class="truncate">
                    <h5 class="text-xs font-bold text-white">Administrator</h5>
                    <p class="text-[10px] text-brand-bone/40 truncate">admin@munchies.com</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Workspace -->
    <div class="flex-grow flex flex-col min-h-screen">
        <!-- Top Workspace Bar -->
        <header class="h-16 border-b border-brand-forest/5 bg-white px-8 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="ph ph-clock text-gray-400"></i>
                <span class="text-xs text-gray-500 font-semibold">Giờ hệ thống: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            
            <div class="flex items-center gap-4">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-matcha bg-brand-matcha/10 px-3 py-1 rounded-full flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-matcha animate-ping"></span>
                    <span>Hệ thống trực tuyến</span>
                </span>
            </div>
        </header>

        <!-- Dynamic Content -->
        <main class="p-8 flex-grow">
            @RenderBody()
        </main>
    </div>

    <!-- Script imports -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
