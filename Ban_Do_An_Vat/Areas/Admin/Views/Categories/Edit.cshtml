@model Ban_Do_An_Vat.Models.Category
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="max-w-xl mx-auto space-y-6 animate-fade-up">
    <!-- Header -->
    <div class="flex items-center gap-4">
        <a asp-action="Index" class="w-10 h-10 rounded-full bg-white hover:bg-brand-forest/5 text-brand-forest flex items-center justify-center shadow-sm transition-colors border border-brand-forest/5">
            <i class="ph ph-arrow-left-bold"></i>
        </a>
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-brand-forest">Chỉnh Sửa Danh Mục</h1>
            <p class="text-xs text-gray-500 mt-0.5">Cập nhật thông tin phân loại sản phẩm.</p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="p-8 rounded-[1.8rem] bg-white border border-brand-forest/5 shadow-sm">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs">
                    <div asp-validation-summary="ModelOnly" class="font-semibold"></div>
                </div>
            }

            <div class="flex flex-col gap-1.5">
                <label asp-for="Name" class="text-xs font-bold uppercase tracking-wider text-brand-forest">Tên Danh Mục</label>
                <input asp-for="Name" type="text"
                       class="w-full bg-brand-light border border-brand-forest/5 rounded-full px-5 py-3 text-xs focus:outline-none focus:ring-1 focus:ring-brand-coral focus:border-brand-coral" />
                <span asp-validation-for="Name" class="text-xs text-red-600 font-semibold mt-0.5"></span>
            </div>

            <div class="flex flex-col gap-1.5">
                <label asp-for="ImageUrl" class="text-xs font-bold uppercase tracking-wider text-brand-forest">Đường dẫn hình ảnh (URL)</label>
                <input asp-for="ImageUrl" type="text"
                       class="w-full bg-brand-light border border-brand-forest/5 rounded-full px-5 py-3 text-xs focus:outline-none focus:ring-1 focus:ring-brand-coral focus:border-brand-coral" />
                <span asp-validation-for="ImageUrl" class="text-xs text-red-600 font-semibold mt-0.5"></span>
            </div>

            <div class="flex flex-col gap-1.5">
                <label asp-for="Description" class="text-xs font-bold uppercase tracking-wider text-brand-forest">Mô tả danh mục</label>
                <textarea asp-for="Description" rows="3"
                          class="w-full bg-brand-light border border-brand-forest/5 rounded-[1.5rem] px-5 py-3 text-xs focus:outline-none focus:ring-1 focus:ring-brand-coral focus:border-brand-coral"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600 font-semibold mt-0.5"></span>
            </div>

            <!-- Actions buttons -->
            <div class="flex gap-4 pt-4 border-t border-brand-forest/5">
                <button type="submit" class="w-full bg-brand-coral text-white font-bold py-3.5 rounded-full hover:bg-brand-coral/90 transition-all shadow-md shadow-brand-coral/20">
                    Lưu thay đổi
                </button>
                <a asp-action="Index" class="w-full text-center border border-brand-forest/10 text-brand-forest font-bold py-3.5 rounded-full hover:bg-brand-forest/5 transition-all">
                    Hủy bỏ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
