@model ApplicationUser
@{
    ViewData["Title"] = "Chi tiết Khách Hàng";
    var orders = ViewBag.Orders as IEnumerable<Ban_Do_An_Vat.Models.Order>;
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-brand-forest text-sm font-semibold hover:text-brand-coral transition-colors mb-4">
        <i class="ph ph-arrow-left"></i>
        <span>Quay lại danh sách</span>
    </a>
    <h1 class="text-2xl font-bold text-brand-forest">Chi Tiết Khách Hàng</h1>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8 animate-fade-up">
    <div class="md:col-span-1 space-y-6 stagger-1">
        <div class="outer-shell">
            <div class="inner-core p-6 space-y-4">
            <div class="w-20 h-20 rounded-full bg-brand-coral/20 text-brand-coral flex items-center justify-center text-3xl font-bold mx-auto">
                <i class="ph ph-user"></i>
            </div>
            <div class="text-center">
                <h2 class="text-lg font-bold text-brand-forest">@Model.FullName</h2>
                <p class="text-sm text-gray-500">Khách hàng thành viên</p>
            </div>
            
            <div class="border-t border-brand-forest/5 pt-4 space-y-2 text-sm text-brand-forest">
                <div>
                    <span class="block text-xs text-gray-400 font-bold uppercase tracking-wider">Email</span>
                    <span>@Model.Email</span>
                </div>
                <div>
                    <span class="block text-xs text-gray-400 font-bold uppercase tracking-wider">Số Điện Thoại</span>
                    <span>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                </div>
                <div>
                    <span class="block text-xs text-gray-400 font-bold uppercase tracking-wider">Địa Chỉ Giao Hàng Mặc Định</span>
                    <span class="text-xs">@(string.IsNullOrEmpty(Model.Address) ? "Chưa cập nhật" : Model.Address)</span>
                </div>
            </div>
            </div>
            </div>
        </div>
    </div>

    <div class="md:col-span-2 stagger-2">
        <div class="outer-shell h-full">
            <div class="inner-core p-6">
            <h2 class="text-lg font-bold text-brand-forest mb-4 border-b border-brand-forest/5 pb-2">Lịch sử đơn hàng</h2>
            @if (orders != null && orders.Any())
            {
                <div class="space-y-4">
                    @foreach (var order in orders)
                    {
                        <div class="flex justify-between items-center p-4 bg-brand-bone/50 rounded-xl">
                            <div>
                                <div class="font-bold text-brand-forest">Đơn hàng #@order.Id</div>
                                <div class="text-xs text-gray-500">@order.OrderDate.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="text-right">
                                <div class="font-bold text-brand-coral">@order.TotalAmount.ToString("N0")đ</div>
                                <span class="text-xs font-semibold @(order.Status == "Delivered" ? "text-green-600" : "text-brand-matcha")">
                                    @order.Status
                                </span>
                            </div>
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="text-brand-matcha hover:text-brand-coral">
                                <i class="ph ph-caret-right text-lg"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-500 text-center py-4">Khách hàng này chưa có đơn hàng nào.</p>
            }
            }
            </div>
        </div>
    </div>
</div>
