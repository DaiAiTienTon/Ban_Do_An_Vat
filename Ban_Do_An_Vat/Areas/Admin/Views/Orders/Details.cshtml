@model Ban_Do_An_Vat.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center gap-2 text-brand-forest text-sm font-semibold hover:text-brand-coral transition-colors mb-4">
        <i class="ph ph-arrow-left"></i>
        <span>Quay lại</span>
    </a>
    <h1 class="text-2xl font-bold text-brand-forest">Chi Tiết Đơn Hàng #@Model.Id</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8">
        <div class="bg-white rounded-2xl shadow-sm border border-brand-forest/5 p-6">
            <h2 class="text-lg font-bold text-brand-forest mb-4 border-b border-brand-forest/5 pb-2">Danh sách sản phẩm</h2>
            <div class="space-y-4">
                @foreach (var item in Model.OrderItems)
                {
                    var isCombo = item.ComboId > 0;
                    var imageUrl = isCombo ? item.Combo?.ImageUrl : item.Snack?.ImageUrl;
                    var displayName = isCombo ? item.Combo?.Name : item.Snack?.Name;
                    
                    <div class="flex items-center gap-4 py-2">
                        <div class="w-16 h-16 rounded-xl overflow-hidden bg-brand-bone shrink-0">
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl" alt="@displayName" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center bg-brand-amber/10 text-brand-amber">
                                    <i class="ph ph-package text-2xl"></i>
                                </div>
                            }
                        </div>
                        <div class="flex-grow">
                            <h4 class="font-bold text-brand-forest text-sm">
                                @if (isCombo)
                                {
                                    <span class="inline-block bg-brand-coral text-white text-[9px] font-extrabold px-1 rounded mr-1">COMBO</span>
                                }
                                @(displayName ?? "Sản phẩm")
                            </h4>
                            <div class="text-xs text-brand-forest/60">Số lượng: @item.Quantity</div>
                        </div>
                        <div class="text-right">
                            <div class="font-bold text-brand-coral">@item.Price.ToString("N0")đ</div>
                            <div class="text-xs text-brand-forest/60 mt-1">Tổng: @((item.Quantity * item.Price).ToString("N0"))đ</div>
                        </div>
                    </div>
                }
            </div>
            
            <!-- Order pricing summary -->
            <div class="border-t border-brand-forest/5 mt-6 pt-4 space-y-2 text-right text-xs">
                <div>
                    <span class="text-gray-500 font-semibold">Tạm tính sản phẩm:</span>
                    <span class="font-mono font-bold text-brand-forest text-sm ml-2">@Model.OrderItems.Sum(oi => oi.Quantity * oi.Price).ToString("N0")đ</span>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div>
                        <span class="text-brand-coral font-semibold">Giảm giá (@Model.CouponCode):</span>
                        <span class="font-mono font-bold text-brand-coral text-sm ml-2">-@Model.DiscountAmount.ToString("N0")đ</span>
                    </div>
                }
                <div class="border-t border-brand-forest/5 pt-2 text-sm font-bold">
                    <span class="text-brand-forest">Thực thu:</span>
                    <span class="font-mono text-brand-coral text-base ml-2">@Model.TotalAmount.ToString("N0")đ</span>
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-8">
        <div class="bg-white rounded-2xl shadow-sm border border-brand-forest/5 p-6">
            <h2 class="text-lg font-bold text-brand-forest mb-4 border-b border-brand-forest/5 pb-2">Thông tin khách hàng</h2>
            <div class="space-y-3 text-sm">
                <div>
                    <span class="block text-gray-500 mb-1">Họ tên</span>
                    <span class="font-bold text-brand-forest">@Model.CustomerName</span>
                </div>
                <div>
                    <span class="block text-gray-500 mb-1">Số điện thoại</span>
                    <span class="font-bold text-brand-forest">@Model.CustomerPhone</span>
                </div>
                <div>
                    <span class="block text-gray-500 mb-1">Địa chỉ giao hàng</span>
                    <span class="font-bold text-brand-forest">@Model.DeliveryAddress</span>
                </div>
                <div>
                    <span class="block text-gray-500 mb-1">Ghi chú</span>
                    <span class="text-brand-forest">@(string.IsNullOrEmpty(Model.OrderNotes) ? "Không có" : Model.OrderNotes)</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-brand-forest/5 p-6">
            <h2 class="text-lg font-bold text-brand-forest mb-4 border-b border-brand-forest/5 pb-2">Cập nhật trạng thái</h2>
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-brand-forest mb-2">Trạng thái đơn hàng</label>
                    <select name="status" class="w-full bg-brand-bone border border-brand-forest/10 rounded-xl px-4 py-2 text-sm focus:outline-none focus:border-brand-matcha">
                        <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xác nhận</option>
                        <option value="Processing" selected="@(Model.Status == "Processing")">Đang xử lý</option>
                        <option value="Shipped" selected="@(Model.Status == "Shipped")">Đang giao hàng</option>
                        <option value="Delivered" selected="@(Model.Status == "Delivered")">Đã giao hàng (Hoàn thành)</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã Hủy</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-brand-matcha text-white font-bold py-2 rounded-xl hover:bg-brand-matcha/90 transition-colors">
                    Lưu Thay Đổi
                </button>
            </form>
        </div>
    </div>
</div>
