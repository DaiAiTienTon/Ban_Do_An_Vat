# ── .gitignore cho Ban_Do_An_Vat ──────────────────────────────────────────
# Tạo 07/08/2026
# ─────────────────────────────────────────────────────────────────────────

# ── Build outputs ─────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ── Visual Studio ─────────────────────────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ── NuGet ────────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/build/

# ── ASP.NET Scaffolding ───────────────────────────────────────────────────
ScaffoldingReadMe.txt

# ── Node.js (nếu dùng npm cho front-end tools) ───────────────────────────
node_modules/
npm-debug.log*

# ── Publish output ────────────────────────────────────────────────────────
publish/
[Pp]ublish/

# ── User Secrets (QUAN TRỌNG: không push lên GitHub) ─────────────────────
**/secrets.json
appsettings.*.json
!appsettings.Development.json

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Rider / JetBrains ─────────────────────────────────────────────────────
.idea/
*.sln.iml
